{
  "name": "@devel-solid/agentscli",
  "version": "0.7.0",
  "description": "Install skills for authoring conventions and generating a project AGENTS.md index.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devel-solid/agentscli.git"
  },
  "homepage": "https://github.com/devel-solid/agentscli#readme",
  "bugs": "https://github.com/devel-solid/agentscli/issues",
  "type": "module",
  "bin": {
    "agentscli": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/assets/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/package-assets.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src assets/templates/skills scripts tests/unit package.json tsconfig.json",
    "format:check": "prettier --check src assets/templates/skills scripts tests/unit package.json tsconfig.json",
    "test": "tsc && node scripts/test.mjs",
    "check": "npm run typecheck && npm run format:check && npm test",
    "prepack": "npm run build"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || ^26.0.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "imports": {
    "#engine": "./dist/assets/skills/agentscli-build-agents/scripts/lib/index.mjs"
  }
}
